---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sprite from '../components/Sprite.astro';
import Clip from '../components/Clip.astro';
import { getContent } from '../content';
import { sprites } from '../sprites/manifest';

const { hero, heroOptions, ui } = getContent();

// Burbujas cuadradas que suben (plan §10.6): [izquierda %, tamaño px, duración s, retraso s]. Máximo 10.
const bubbles = [
  [8, 10, 7, 0],
  [18, 6, 9, 2],
  [30, 14, 8, 4],
  [41, 8, 10, 1],
  [52, 6, 7, 3],
  [60, 12, 11, 5],
  [68, 8, 8, 2.5],
  [76, 16, 9, 0.5],
  [86, 6, 7, 3.5],
  [93, 10, 10, 6],
];

// Cuatro flechas de ritmo; cada una llega ya orientada desde Codex (←↓↑→).
// data-arrow las une con el clip de Boyfriend de la misma dirección (scripts/actors.ts).
const arrows = [
  { slot: sprites.arrowLeft, dir: 'left', glyph: '←' },
  { slot: sprites.arrowDown, dir: 'down', glyph: '↓' },
  { slot: sprites.arrowUp, dir: 'up', glyph: '↑' },
  { slot: sprites.arrowRight, dir: 'right', glyph: '→' },
];
---

<BaseLayout home title={ui.siteTitle}>
  <section class="hero page-enter">
    <!-- Fondo Dark Hour: degradado, dos rayos y burbujas cuadradas (solo CSS, sin imágenes pesadas) -->
    <div class="hero__bg" aria-hidden="true" data-loop>
      <div
        class="hero__ray"
        style="left: 46%; width: 90px; background: linear-gradient(180deg, rgba(168,240,200,.10), rgba(168,240,200,0))"
      ></div>
      <div
        class="hero__ray"
        style="left: 62%; width: 40px; background: linear-gradient(180deg, rgba(73,224,240,.10), rgba(73,224,240,0)); animation-delay: -3s"
      ></div>
      {bubbles.map(([left, size, dur, delay]) => (
        <div
          class="hero__bubble"
          style={`left:${left}%;width:${size}px;height:${size}px;animation-duration:${dur}s;animation-delay:${delay}s`}
        />
      ))}
    </div>

    <!-- Franja menta con la palabra lateral cortada por el borde -->
    <div class="hero__side" aria-hidden="true">
      <div class="hero__word">
        <div class="hero__word-text">{hero.sideWord}</div>
      </div>
    </div>

    <div class="hero__inner">
      <div class="hero__main">
        <div class="hero__stack">
          <p class="hero__label mono hero__item" style="animation-delay: .45s">
            {hero.label}
          </p>
          <h1 class="hero__name hero__item" style="animation-delay: .51s">
            {hero.name}
          </h1>
          <ul
            class="hero__options"
            data-select-group
            data-arrow-nav
            data-select-targets="#hero-poses"
          >
            {heroOptions.map((option, i) => (
              <li class="hero__item" style={`animation-delay: ${(0.57 + i * 0.06).toFixed(2)}s`}>
                <a
                  class="option"
                  href={`/${option.page}`}
                  data-select-item
                  data-sel={String(i === 0)}
                  style={`font-size:${option.size}px;color:${option.color}`}
                >
                  <span class="option__slash" aria-hidden="true" />
                  <span class="option__plate" aria-hidden="true" />
                  <span class="option__label">{option.label}</span>
                  <span class="option__sub">{option.sub}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="hero__late hero__pitch">
          <p class="hero__headline">{hero.headline}</p>
          <p class="hero__support">{hero.support}</p>
        </div>
      </div>

      <!-- Recorte 3D: hoy un marcador; luego la tira WebP del personaje (plan §15). Cae girando y queda cortado por el borde. -->
      <div class="hero__stage" aria-hidden="true">
        <div class="hero__cutout">
          <div class="hero__sil">
            <div class="hero__sway" data-loop>
              <div class="hero__poses" id="hero-poses">
                {heroOptions.map((option, i) => (
                  <div class="hero__pose fx-fade" data-panel hidden={i !== 0}>
                    <div class="hero__pose-tag mono">RENDER 3D · POSE {i + 1}</div>
                    <div class="hero__pose-name">[{option.pose}]</div>
                    <div class="hero__pose-note">{hero.poseNote}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="actor hero__late hero__butterfly" data-loop>
          <!-- La ruta la pone fx-fly; el aleteo lo dibuja la tira. Sobre la silueta se posa (hover). -->
          <div class="fx-fly hero__butterfly-route">
            <Clip name="butterfly" clips={['p3-butterfly-fly', 'p3-butterfly-hover']} />
          </div>
        </div>
      </div>
    </div>

    <div class="hero__hint hero__late">
      <span class="hero__eco" aria-hidden="true" data-loop>
        <!-- Sin fx-eco-beat: el reposo dibujado ya late a 100 BPM y el rebote saldría doble -->
        <Clip
          name="boyfriend"
          clips={[
            'boyfriend-idle',
            'boyfriend-up',
            'boyfriend-down',
            'boyfriend-left',
            'boyfriend-right',
          ]}
        />
      </span>
      <span class="hero__keys" aria-hidden="true" data-loop>
        {arrows.map(({ slot, dir, glyph }, i) => (
          <span class="hero__arrow" data-arrow={dir}>
            <span
              class="fx-beat-key"
              style={`position:absolute;inset:0;animation-delay:${i * 0.15}s`}
            >
              <Sprite sprite={slot} fallback={glyph} />
            </span>
          </span>
        ))}
      </span>
      {hero.hints.map((hint) => (
        <span>
          <b>{hint.key}</b> {hint.text}
        </span>
      ))}
    </div>

    <div class="sweep" aria-hidden="true"></div>
    <div class="sweep sweep--white" aria-hidden="true"></div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 800px;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 18%, #12493a 0%, #0a2a22 38%, #07110c 80%);
  }
  .hero__ray {
    position: absolute;
    top: -10%;
    height: 130%;
    animation: drift 9s var(--ease-breathe) infinite alternate;
  }
  .hero__bubble {
    position: absolute;
    bottom: -20px;
    border: 2px solid rgba(168, 240, 200, 0.55);
    animation: rise linear infinite;
  }

  .hero__side {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: clamp(72px, 10vw, 150px);
    background: var(--color-mint);
    overflow: hidden;
  }
  .hero__word {
    position: absolute;
    inset: 0;
    animation: slide-up 0.5s var(--ease-p3r) 0.3s both;
  }
  .hero__word-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-top: 24px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(110px, 16vw, 230px);
    line-height: 0.8;
    color: var(--color-bg);
    white-space: nowrap;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1360px;
    margin: 0 auto;
    padding: 130px var(--gutter) 110px clamp(96px, 14vw, 200px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-end;
  }
  .hero__main {
    flex: 999 1 520px;
    min-width: 0;
  }
  /* La lista entera rota -8°; el texto corrido queda recto (plan §10.5). */
  .hero__stack {
    transform: rotate(-8deg);
    transform-origin: left top;
  }
  .hero__item {
    animation: cascade 0.45s var(--ease-p3r) both;
  }
  .hero__late {
    animation: fade-in 0.3s ease-out 1.1s both;
  }
  .hero__label {
    margin: 0 0 10px;
    font-size: 15px;
    color: var(--color-neon);
    letter-spacing: 0.06em;
  }
  .hero__name {
    margin: 0 0 14px;
    display: inline-block;
    padding: 6px 40px 10px 18px;
    background: var(--color-paper);
    color: var(--color-bg);
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(56px, 8vw, 112px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    clip-path: polygon(0 10%, 100% 0, 96% 100%, 2% 92%);
  }
  .hero__options {
    list-style: none;
    margin: 0;
    padding: 0 0 0 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hero__pitch {
    margin-top: 50px;
    max-width: 46ch;
  }
  .hero__headline {
    margin: 0 0 8px;
    font-size: 21px;
    line-height: 1.4;
    font-weight: 600;
  }
  .hero__support {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-mint);
  }

  .hero__stage {
    flex: 1 1 320px;
    min-width: 280px;
    height: 520px;
    position: relative;
  }
  .hero__cutout {
    position: absolute;
    left: 10px;
    top: 0;
    width: 420px;
    height: 500px;
  }
  .hero__sil {
    position: absolute;
    inset: 0;
    transform: rotate(-24deg);
    transform-origin: 50% 40%;
    animation: sil-drop 0.7s var(--ease-drop) 0.15s both;
  }
  .hero__sway {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 48px;
    text-align: center;
    border: 3px dashed var(--line-strong);
    background: linear-gradient(
      160deg,
      rgba(73, 224, 240, 0.16),
      rgba(57, 255, 136, 0.08) 60%,
      rgba(7, 17, 12, 0)
    );
    clip-path: polygon(8% 0, 100% 4%, 92% 100%, 0 94%);
    transform-origin: 50% 20%;
    animation: sway 6s var(--ease-breathe) 1s infinite;
  }
  .hero__poses {
    transform: rotate(24deg);
    max-width: 320px;
  }
  .hero__pose-tag {
    margin-bottom: 10px;
    font-size: 14px;
    color: var(--color-neon);
  }
  .hero__pose-name {
    font-weight: 900;
    font-style: italic;
    font-size: 30px;
    line-height: 1.05;
    color: var(--color-paper);
  }
  .hero__pose-note {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-mint);
  }
  .hero__butterfly {
    left: 10px;
    top: 40px;
    width: 45px;
    height: 35px;
  }

  .hero__hint {
    position: absolute;
    z-index: 2;
    right: 24px;
    bottom: 20px;
    display: flex;
    gap: 18px;
    align-items: center;
    font-size: 14px;
  }
  .hero__hint b {
    color: var(--color-neon);
  }
  .hero__eco {
    position: relative;
    width: 96px;
    height: 96px;
    margin-right: 6px;
  }
  .hero__keys {
    display: inline-flex;
    gap: 6px;
  }
  .hero__arrow {
    position: relative;
    width: 28px;
    height: 28px;
    cursor: pointer;
    touch-action: none;
    transition:
      transform 0.08s var(--ease-p3r),
      filter 0.08s ease-out;
  }
  /* Solo se enciende la flecha que se está pulsando */
  .hero__arrow[data-hit] {
    transform: scale(1.3);
    filter: brightness(1.5) drop-shadow(0 0 6px var(--color-neon));
  }
  .hero__butterfly-route {
    position: absolute;
    inset: 0;
  }
  /* Posada sobre la silueta: la ruta se detiene y solo bate las alas */
  .hero__butterfly[data-rest] .hero__butterfly-route {
    animation-play-state: paused;
  }
</style>
