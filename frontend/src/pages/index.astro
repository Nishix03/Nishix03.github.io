---
// PÁGINA DE INICIO (index.astro) - la portada del portafolio.
// Muestra el nombre, un menú de 5 opciones (About, Projects, Stack, Journey, Contact), un avatar y decoración animada.
// RUTAS POR ARCHIVO EN ASTRO: cada archivo de src/pages/ es una URL. Este archivo es la raíz "/"; about.astro sería "/about".
// La versión en español (/es/) está en pages/es/index.astro y solo reutiliza este mismo archivo.
// FRONTMATTER: lo que va entre las dos líneas --- es código que corre al construir la página (en el build),
// nunca en el navegador. Aquí se importan componentes y se preparan los datos que usa el HTML de abajo.
import BaseLayout from '../layouts/BaseLayout.astro';
import Clip from '../components/Clip.astro';
import AvatarCutin from '../components/AvatarCutin.astro';
import { getContent, localeFromUrl, localePath } from '../content';
import { sprites } from '../sprites/manifest';

// localeFromUrl mira la URL actual (Astro.url) y devuelve el idioma: inglés normal o español si empieza por /es/.
// Así una sola página sirve a los dos idiomas.
const locale = localeFromUrl(Astro.url);
// getContent(locale) devuelve todos los textos del sitio en ese idioma (viven en src/content).
// Con desestructuración sacamos solo lo que esta página necesita:
// hero = textos de la portada, heroOptions = las 5 opciones del menú, ui = textos generales (título del sitio, etc.).
const { hero, heroOptions, ui } = getContent(locale);

// Datos puramente decorativos: cada fila es una burbuja. Se declaran como lista para generar los <div>
// con .map() más abajo, en vez de escribir 10 <div> a mano. Los valores se usan en el atributo style (CSS en línea).
// Burbujas cuadradas que suben (plan §10.6): [izquierda %, tamaño px, duración s, retraso s]. Máximo 10.
const bubbles = [
  [8, 10, 7, 0],
  [18, 6, 9, 2],
  [30, 14, 8, 4],
  [41, 8, 10, 1],
  [52, 6, 7, 3],
  [60, 12, 11, 5],
  [68, 8, 8, 2.5],
  [76, 16, 9, 0.5],
  [86, 6, 7, 3.5],
  [93, 10, 10, 6],
];

---

<!--
  BaseLayout es el marco común de todas las páginas (head, menú, fuentes...). Lo que va dentro se coloca en su slot.
  La prop "home" le indica que es la portada. {ui.siteTitle} es una expresión: Astro inserta el valor de la variable.
-->
<BaseLayout home title={ui.siteTitle}>
  <!--
    BLOQUE hero: toda la portada. BEM: hero = bloque; hero__bg, hero__inner... = elementos (partes del bloque).
    Esta página casi no usa modificadores (la parte con doble guion).
  -->
  <section class="hero page-enter">
    <!-- Fondo Dark Hour: degradado, dos rayos y burbujas cuadradas (solo CSS, sin imágenes pesadas) -->
    <!--
      Capa de fondo. aria-hidden="true" la oculta a lectores de pantalla (es solo adorno).
      data-loop es un DATA-ATTRIBUTE (atributo data-*): no hace nada solo, pero el JS global lo usa como marca
      (por ejemplo para pausar animaciones infinitas cuando no se ven).
    -->
    <div class="hero__bg" aria-hidden="true" data-loop>
      <div
        class="hero__ray"
        style="left: 46%; width: 90px; background: linear-gradient(180deg, rgba(168,240,200,.10), rgba(168,240,200,0))"
      ></div>
      <div
        class="hero__ray"
        style="left: 62%; width: 40px; background: linear-gradient(180deg, rgba(73,224,240,.10), rgba(73,224,240,0)); animation-delay: -3s"
      ></div>
      <!--
        Se recorre la lista bubbles y se crea un <div> por burbuja. Los datos viajan por style en línea,
        así cada burbuja tiene su posición, tamaño y tiempo de animación (la animación "rise" está en el CSS global).
      -->
      {bubbles.map(([left, size, dur, delay]) => (
        <div
          class="hero__bubble"
          style={`left:${left}%;width:${size}px;height:${size}px;animation-duration:${dur}s;animation-delay:${delay}s`}
        />
      ))}
    </div>

    <!-- Componente que dibuja el avatar (recorte del personaje). La prop page decide qué imagen usar en esta página. -->
    <AvatarCutin page="hero" />

    <!-- Franja menta con la palabra lateral cortada por el borde -->
    <!-- Franja menta lateral con la palabra grande (hero.sideWord) girada y cortada por el borde. -->
    <div class="hero__side" aria-hidden="true">
      <div class="hero__word">
        <div class="hero__word-text">{hero.sideWord}</div>
      </div>
    </div>

    <!-- Contenedor principal del contenido: a la izquierda el menú y el texto (hero__main), a la derecha el escenario (hero__stage). -->
    <div class="hero__inner">
      <div class="hero__main">
        <div class="hero__stack">
          <p class="hero__label mono hero__item" style="animation-delay: .22s">
            {hero.label}
          </p>
          <h1 class="hero__name hero__item" style="animation-delay: .28s">
            {hero.name}
          </h1>
          <!--
            MENÚ DE OPCIONES. Atributos data-* que lee el script global de selección (select-group.ts):
            data-select-group = esto es un grupo de elementos seleccionables; data-arrow-nav = se mueve con las flechas del teclado.
            Cada enlace con data-select-item es una opción; data-sel indica cuál está seleccionada ahora (la primera, i === 0).
          -->
          <ul
            class="hero__options"
            data-select-group
            data-arrow-nav
          >
            <!--
              Una opción por cada elemento de heroOptions. localePath añade el prefijo /es cuando el idioma es español.
              El retraso (animation-delay) de cada li crece con i, así las opciones entran en cascada una tras otra.
            -->
            {heroOptions.map((option, i) => (
              <li class="hero__item" style={`animation-delay: ${(0.34 + i * 0.05).toFixed(2)}s`}>
                <a
                  class="option"
                  href={localePath(locale, `/${option.page}`)}
                  data-select-item
                  data-sel={String(i === 0)}
                  style={`--opt-size:${option.size}px;color:${option.color}`}
                >
                  <span class="option__slash" aria-hidden="true" />
                  <span class="option__plate" aria-hidden="true" />
                  <span class="option__label">{option.label}</span>
                  <span class="option__sub">{option.sub}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <!-- Texto de presentación (titular y apoyo). La clase hero__late hace que aparezca un poco después (fade-in). -->
        <div class="hero__late hero__pitch">
          <p class="hero__headline">{hero.headline}</p>
          <p class="hero__support">{hero.support}</p>
        </div>
      </div>

      <!-- El avatar (un solo reposo, no cambia con la opción) va en AvatarCutin; la mariposa se posa sobre él -->
      <!-- Escenario derecho. El avatar va en AvatarCutin; aquí solo vuela la mariposa decorativa (sprite animado con Clip). -->
      <div class="hero__stage" aria-hidden="true">
        <div class="actor hero__late hero__butterfly" data-loop>
          <!-- La ruta la pone fx-fly; el aleteo lo dibuja la tira. Sobre la silueta se posa (hover). -->
          <div class="fx-fly hero__butterfly-route">
            <Clip name="butterfly" clips={['p3-butterfly-fly', 'p3-butterfly-hover']} />
          </div>
        </div>
      </div>
    </div>

    <!-- Pistas de teclado (por ejemplo "Enter Confirm"). Se generan desde hero.hints. En pantallas táctiles se ocultan por CSS. -->
    <div class="hero__hint hero__late">
      {hero.hints.map((hint) => (
        <span>
          <b>{hint.key}</b> {hint.text}
        </span>
      ))}
    </div>

    <!-- Dos "barridos" de color: efecto de transición al entrar a la página (estilos globales). -->
    <div class="sweep" aria-hidden="true"></div>
    <div class="sweep sweep--white" aria-hidden="true"></div>
  </section>
</BaseLayout>

<style>
  /*
   ESTILOS DE ESTA PÁGINA. En Astro un style queda "con alcance" (scoped): solo afecta a los elementos de este archivo.
   Por eso, para estilar elementos que vienen de otros componentes (como .option) se usa :global(...).
   Nota: aquí las reglas @media van ANTES de las reglas base y casi todas usan max-width (corregir para pantallas pequeñas).
   La convención del proyecto es mobile first (base para móvil y @media (min-width: ...) para pantallas grandes);
   esta página nació al revés, desde escritorio.
   */
  /* El tamaño de cada opción baja con el ancho de la pantalla: «PROJECTS» no se sale en 390 px. */
  /*
   El tamaño de cada opción viene de la variable CSS --opt-size (puesta en el HTML con style).
   min(a, b) elige el menor de los dos valores: así el texto nunca pasa del 10,5 % del ancho de pantalla (vw).
   */
  .hero__options :global(.option) {
    font-size: min(var(--opt-size), 10.5vw);
  }
  /* max-width: 767px = pantallas de móvil. Oculta la etiqueta secundaria de cada opción para que no se salga. */
  @media (max-width: 767px) {
    /* Las etiquetas pequeñas (Persona, Skills…) se salían de la pantalla: el nombre ya dice el apartado. */
    .hero__options :global(.option__sub) {
      display: none;
    }
  }
  /* Pantallas muy estrechas: franja menta casi sin ancho y textos que bajan con el ancho (a 320 px todo cabe). */
  /* Móviles muy estrechos (hasta 479 px): se reduce la franja lateral y las fuentes. */
  @media (max-width: 479px) {
    .hero .hero__side {
      width: 16px;
    }
    .hero .hero__inner {
      padding-left: 28px;
      padding-right: 16px;
    }
    .hero .hero__name {
      padding: 6px 20px 8px 12px;
      font-size: min(56px, 13.5vw);
    }
    .hero__options :global(.option) {
      font-size: min(var(--opt-size), 9vw);
    }
  }
  /* Móvil apaisado (poca altura): nombre más pequeño, opciones en 3 columnas y franja estrecha,
     para ver los cinco apartados sin hacer scroll. */
  /* Móvil apaisado (horizontal, poca altura): las 5 opciones pasan a una cuadrícula de columnas con grid. */
  @media (orientation: landscape) and (max-height: 500px) {
    .hero .hero__side {
      width: 24px;
    }
    .hero .hero__inner {
      padding: 72px 24px 24px 48px;
    }
    .hero .hero__name {
      font-size: min(56px, 9vh);
      padding: 4px 24px 6px 14px;
    }
    .hero .hero__options {
      display: grid;
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
      gap: 0 40px;
    }
    .hero .hero__stack {
      transform: rotate(-4deg);
    }
    .hero .hero__options :global(.option) {
      font-size: min(var(--opt-size), 8vh);
    }
  }
  /* «↑↓ Move / Enter Confirm» solo sirve con teclado. */
  /* pointer: coarse = dispositivo con puntero impreciso (el dedo). Ahí se ocultan las pistas de teclado. */
  @media (pointer: coarse) {
    /* Con el dedo no hay teclado: las pistas de teclas no sirven. */
    .hero .hero__hint {
      display: none;
    }
  }
  /*
   Segundo bloque para móvil: simplifica la portada (menos capas, menú en columna con flex). clamp(min, ideal, max)
   fija la fuente entre 24 px y 30 px, usando 7vw cuando cabe.
   */
  @media (max-width: 767px) {
    section.hero {
      min-height: 0;
    }
    /* Contorno oscuro: el menú se lee sobre el avatar, que en móvil ahora se ve más. */
    .hero__pitch {
      text-shadow: 0 0 12px var(--color-bg);
    }
    .hero .hero__inner {
      padding-top: 230px;
      padding-bottom: 24px;
    }
    /* Menos capas: sin la franja menta lateral ni las burbujas; el menú apenas inclinado y con todas las
       opciones del mismo tamaño, separadas, en vez de cinco tamaños distintos. */
    .hero .hero__side,
    .hero .hero__bubble,
    .hero .hero__ray {
      display: none;
    }
    .hero .hero__stack {
      transform: rotate(-4deg);
    }
    .hero .hero__name {
      font-size: min(48px, 12vw);
    }
    .hero .hero__options {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .hero .hero__options :global(.option) {
      font-size: clamp(24px, 7vw, 30px);
    }
    /* El escenario de 520 px (de cuando el avatar iba en la columna) no tiene contenido en móvil:
       sin altura, la mariposa sigue volando sobre el texto y no queda un hueco. */
    .hero .hero__stage {
      height: 0;
      min-height: 0;
      flex-basis: 0;
    }
    .hero .hero__hint {
      position: relative;
      left: auto;
      bottom: auto;
      margin: 0 0 40px clamp(28px, 10vw, 96px);
      flex-wrap: wrap;
    }
  }
  /* Móvil apaisado (poca altura): la franja de arriba dejaría el menú fuera de la pantalla, así que el avatar
     vuelve detrás, a la derecha, y el menú empieza arriba. Va después de las reglas de móvil para ganarles. */
  /* Se repite el caso apaisado a propósito después del bloque móvil: con igual especificidad gana la regla que va última. */
  @media (orientation: landscape) and (max-height: 500px) {
    .hero .hero__inner {
      padding-top: 72px;
    }
    .hero .hero__name {
      font-size: min(44px, 9vh);
    }
    .hero .hero__options {
      display: grid;
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
      gap: 0 40px;
    }
  }
  /* REGLAS BASE de la portada. position: relative convierte a .hero en la referencia de sus hijos con position: absolute. */
  .hero {
    position: relative;
    min-height: 800px;
    overflow: hidden;
  }
  /* Fondo: degradado radial (circular) de verdes oscuros. inset: 0 es atajo de top/right/bottom/left: 0. */
  .hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 18%, #12493a 0%, #0a2a22 38%, #07110c 80%);
  }
  /* Rayos fijos: moverlos repintaba el fondo y el avatar que tienen encima en cada fotograma. */
  .hero__ray {
    position: absolute;
    top: -10%;
    height: 130%;
    transform: skewX(-20deg);
  }
  /* Burbuja cuadrada que sube; la animación "rise" es lineal e infinita (infinite). */
  .hero__bubble {
    position: absolute;
    bottom: -20px;
    border: 2px solid rgba(168, 240, 200, 0.55);
    animation: rise linear infinite;
  }

  /* Franja menta izquierda. Su ancho usa clamp(72px, 10vw, 150px): crece con la pantalla pero con mínimo y máximo. */
  .hero__side {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: clamp(72px, 10vw, 150px);
    background: var(--color-mint);
    overflow: hidden;
  }
  .hero__word {
    position: absolute;
    inset: 0;
    animation: slide-up 0.5s var(--ease-p3r) 0.3s backwards;
  }
  /* Texto vertical (writing-mode) girado 180 grados para que se lea de abajo hacia arriba. */
  .hero__word-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-top: 24px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(110px, 16vw, 230px);
    line-height: 0.8;
    color: var(--color-bg);
    white-space: nowrap;
  }

  /* Contenido en flex con flex-wrap: si no cabe todo en una fila, el escenario baja. --gutter es una variable CSS global. */
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1360px;
    margin: 0 auto;
    padding: 130px var(--gutter) 110px clamp(96px, 14vw, 200px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-end;
  }
  /* flex: 999 1 520px = crece muchísimo más que su hermano (prioridad al menú), con base de 520 px. min-width: 0 evita desbordes. */
  .hero__main {
    flex: 999 1 520px;
    min-width: 0;
  }
  /* La lista entera rota -8°; el texto corrido queda recto (plan §10.5). */
  .hero__stack {
    transform: rotate(-8deg);
    transform-origin: left top;
  }
  /* Animaciones de entrada: cascade escalona cada elemento; fade-in (hero__late) aparece al final. */
  .hero__item {
    animation: cascade 0.45s var(--ease-p3r) backwards;
  }
  .hero__late {
    animation: fade-in 0.3s ease-out 0.65s backwards;
  }
  .hero__label {
    margin: 0 0 10px;
    font-size: 15px;
    color: var(--color-neon);
    letter-spacing: 0.06em;
  }
  /* El nombre es una placa blanca inclinada; clip-path: polygon recorta el rectángulo con esquinas torcidas. */
  .hero__name {
    margin: 0 0 14px;
    display: inline-block;
    padding: 6px 40px 10px 18px;
    background: var(--color-paper);
    color: var(--color-bg);
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(56px, 8vw, 112px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    clip-path: polygon(0 10%, 100% 0, 96% 100%, 2% 92%);
  }
  .hero__options {
    list-style: none;
    margin: 0;
    padding: 0 0 0 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hero__pitch {
    margin-top: 50px;
    max-width: 46ch;
  }
  .hero__headline {
    margin: 0 0 8px;
    font-size: 21px;
    line-height: 1.4;
    font-weight: 600;
  }
  .hero__support {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-mint);
  }

  /* Escenario derecho: área donde vuela la mariposa. */
  .hero__stage {
    flex: 1 1 320px;
    min-width: 280px;
    height: 520px;
    position: relative;
  }
  /*
   Las reglas hero__cutout, sil, sway y poses parecen heredadas: el avatar ahora lo dibuja AvatarCutin y
   este HTML ya no usa esas clases.
   */
  .hero__cutout {
    position: absolute;
    left: 10px;
    top: 0;
    width: 420px;
    height: 500px;
  }
  .hero__sil {
    position: absolute;
    inset: 0;
    transform: rotate(-24deg);
    transform-origin: 50% 40%;
    animation: sil-drop 0.7s var(--ease-drop) 0.15s backwards;
  }
  .hero__sway {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 48px;
    text-align: center;
    border: 3px dashed var(--line-strong);
    background: linear-gradient(
      160deg,
      rgba(73, 224, 240, 0.16),
      rgba(57, 255, 136, 0.08) 60%,
      rgba(7, 17, 12, 0)
    );
    clip-path: polygon(8% 0, 100% 4%, 92% 100%, 0 94%);
    transform-origin: 50% 20%;
    animation: sway 6s var(--ease-breathe) 1s infinite;
  }
  .hero__poses {
    transform: rotate(24deg);
    max-width: 320px;
  }
  .hero__pose-tag {
    margin-bottom: 10px;
    font-size: 14px;
    color: var(--color-neon);
  }
  .hero__pose-name {
    font-weight: 900;
    font-style: italic;
    font-size: 30px;
    line-height: 1.05;
    color: var(--color-paper);
  }
  .hero__pose-note {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-mint);
  }
  .hero__butterfly {
    left: 10px;
    top: 40px;
    width: 45px;
    height: 35px;
  }

  /* A la izquierda: a la derecha quedaba encima del avatar. */
  /* Pistas de teclado: posicionadas de forma absoluta abajo a la izquierda. */
  .hero__hint {
    position: absolute;
    z-index: 2;
    left: clamp(96px, 14vw, 200px);
    bottom: 20px;
    display: flex;
    gap: 18px;
    align-items: center;
    font-size: 14px;
  }
  .hero__hint b {
    color: var(--color-neon);
  }
  .hero__butterfly-route {
    position: absolute;
    inset: 0;
  }
  /* Posada sobre la silueta: la ruta se detiene y solo bate las alas */
  /* Selector con data-attribute: cuando el JS añade data-rest a la mariposa (se posó), se pausa su ruta. */
  .hero__butterfly[data-rest] .hero__butterfly-route {
    animation-play-state: paused;
  }
</style>
