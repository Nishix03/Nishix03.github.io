---
// PÁGINA ABOUT (/about) - quién soy: presentación, cómo trabajo, qué hago ahora y fuera del teclado.
// RUTAS POR ARCHIVO EN ASTRO: el nombre del archivo (about.astro) es la URL (/about). La versión /es/about está en pages/es/about.astro.
// FRONTMATTER: el código entre las líneas --- se ejecuta al construir la página, no en el navegador.
// Aquí se importan componentes y se preparan los datos que pinta el HTML.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import AvatarCutin from '../components/AvatarCutin.astro';
import Sprite from '../components/Sprite.astro';
import { getContent, localeFromUrl, localePath } from '../content';

// localeFromUrl lee la URL (Astro.url) y devuelve el idioma ('en' o 'es' si empieza por /es/).
const locale = localeFromUrl(Astro.url);
// getContent(locale) trae todos los textos del sitio en ese idioma. Desestructuramos lo necesario:
// about = textos de esta página (eyebrow, lead, body, how, now, off, talk, cv) y ui = textos generales de la interfaz.
const { about, ui } = getContent(locale);
// Datos comunes de la página: título, palabra grande de fondo (word) y número de sección (num).
const page = ui.pages.about;
---

<!--
  BaseLayout = marco común (head, menú, fuentes). El title usa una plantilla de texto con comillas invertidas
  y ${...} para mezclar variables, por ejemplo "About — Nombre del sitio".
-->
<BaseLayout title={`${page.title} — ${ui.siteTitle}`}>
  <!--
    PageShell = carcasa de las páginas interiores: pone la palabra gigante de fondo y el número de sección.
    Sus props (word, wordSize, wordTop, wordRight, wordRotate) solo ajustan tamaño, posición y giro de esa palabra.
    La clase about-page permite cambiar el color de selección solo en esta página (ver el style).
  -->
  <PageShell
    word={page.word}
    num={page.num}
    wordSize={230}
    wordTop={50}
    wordRight={-60}
    wordRotate={-8}
    class="about-page"
  >
    <!-- BLOQUE about (BEM). Sus elementos son about__intro, about__text, about__how... En una columna con separación entre secciones. -->
    <div class="about">
      <!-- PRESENTACIÓN: retrato a un lado y texto al otro (se apilan en móvil gracias a flex-wrap). -->
      <section class="about__intro">
        <!-- Retrato: AvatarCutin dibuja al personaje. aria-hidden porque es decorativo. -->
        <div class="about__portrait" aria-hidden="true">
          <AvatarCutin page="about" />
        </div>
        <!--
          Textos de about (eyebrow, título, lugar, lead). Las clases fx-cascade hacen que cada línea entre una tras otra;
          el retraso se pone en style con animation-delay, creciendo línea a línea.
        -->
        <div class="about__text">
          <p class="about__eyebrow mono fx-cascade">{about.eyebrow}</p>
          <h1 class="about__title display fx-cascade" style="animation-delay: .06s">
            {page.title}
          </h1>
          <p class="about__place mono fx-cascade" style="animation-delay: .12s">{about.place}</p>
          <p class="about__lead fx-cascade" style="animation-delay: .18s">{about.lead}</p>
          <!-- Un párrafo por cada elemento de about.body. toFixed(2) deja el retraso con 2 decimales. -->
          {about.body.map((paragraph, i) => (
            <p
              class="about__body fx-cascade"
              style={`animation-delay: ${(0.24 + i * 0.06).toFixed(2)}s`}
            >
              {paragraph}
            </p>
          ))}
        </div>
      </section>

      <!-- CÓMO TRABAJO: lista de tarjetas. aria-labelledby apunta al id del h2 para que los lectores de pantalla nombren la sección. -->
      <section aria-labelledby="about-how">
        <h2 id="about-how" class="about__h fx-cascade">{about.howTitle}</h2>
        <ul class="about__how">
          {about.how.map((item, i) => (
            <li
              class="about__how-item fx-cascade"
              style={`animation-delay: ${(0.1 + i * 0.06).toFixed(2)}s`}
            >
              <b>{item.title}</b>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Dos columnas en escritorio (Now y Off the keyboard) y la zona de contacto/CV. En móvil todo queda en una columna (CSS grid con areas). -->
      <div class="about__cols">
        <!-- AHORA: qué hago en este momento. Usa una lista de definición (dl > dt/dd): etiqueta + valor. -->
        <section class="about__now" aria-labelledby="about-now">
          <div class="about__now-head">
            <h2 id="about-now" class="about__h about__h--inline fx-cascade">{about.nowTitle}</h2>
            <!--
              Adorno animado: tres sprites que se repiten con map. data-loop es un data-attribute que el JS global usa
              como marca de animación infinita. Sprite pone una imagen o, si no existe, el texto de respaldo (fallback).
            -->
            <span class="about__menace" aria-hidden="true" data-loop>
              {[0, 1, 2].map((i) => (
                <span
                  class="fx-menace about__menace-item"
                  style={`margin-top:${i * -10}px;animation-delay:${i * 0.3}s`}
                >
                  <Sprite sprite="menace" fallback="ゴ" />
                </span>
              ))}
            </span>
          </div>
          <dl class="about__now-list">
            {about.now.map((row, i) => (
              <div
                class="about__now-row fx-cascade"
                style={`animation-delay: ${(0.1 + i * 0.06).toFixed(2)}s`}
              >
                <dt class="mono">{row.label}</dt>
                <dd>{row.text}</dd>
              </div>
            ))}
          </dl>
        </section>

        <!-- FUERA DEL TECLADO: gustos y aficiones, en un recuadro punteado. -->
        <section class="about__off" aria-labelledby="about-off">
          <h2 id="about-off" class="about__off-title">{about.offTitle}</h2>
          <dl class="about__off-list">
            {about.off.map((row) => (
              <div>
                <dt class="mono">{row.label}</dt>
                <dd>{row.text}</dd>
              </div>
            ))}
          </dl>
        </section>
        <!--
          Zona final: enlace a Contact (con el estilo de opción del menú) y aviso de que el CV llegará pronto.
          localePath mantiene el idioma en el enlace (añade /es si hace falta). Esa clase option y sus partes (slash, plate, label, sub)
          vienen del CSS global option.css.
        -->
        <div class="about__next">
        <nav class="about__cta" aria-label={ui.nextSteps}>
        <a class="option" href={localePath(locale, about.talk.href)} style="font-size:34px;color:var(--color-ink)">
          <span class="option__slash" aria-hidden="true" />
          <span class="option__plate" aria-hidden="true" />
          <span class="option__label">{about.talk.label}</span>
          <span class="option__sub">{about.talk.sub}</span>
        </a>
      </nav>
        <p class="about__cv-soon">{about.cv.label} — {ui.cvSoon}</p>
        </div>
      </div>

    </div>
  </PageShell>
</BaseLayout>

<style>
  /*
   ESTILOS DE ESTA PÁGINA. En Astro un style es "con alcance" (scoped): solo afecta a este archivo.
   Para estilar algo de fuera (el body, o clases de otros componentes) se usa :global(...).
   Convención del proyecto: BEM (about__elemento) y mobile first: reglas base pensadas para móvil y
   @media (min-width: ...) para pantallas mayores. Los colores salen de variables CSS (var(--color-...)).
   */
  /* Sobrescribe la variable --sel solo en la página con la clase about-page: así toda la página usa el dorado. */
  /* About usa el dorado como color de selección (la banda del avatar y los tajos). */
  :global(.about-page) {
    --sel: var(--color-gold);
  }
  /* Contenedor: flex en columna con 48 px entre secciones. */
  .about {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  /* flex-wrap: wrap deja que retrato y texto se apilen cuando no caben en una fila. */
  .about__intro {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-end;
  }
  /* flex: 0 1 300px = no crece, puede encoger, base de 300 px. */
  .about__portrait {
    position: relative;
    flex: 0 1 300px;
    min-width: 240px;
    height: 380px;
  }
  /* Regla de móvil (max-width): el retrato ocupa todo el ancho y se hace más bajo. */
  @media (max-width: 767px) {
    .about__portrait {
      flex-basis: 100%;
      height: 330px; /* franja de retrato: el avatar se ve entero (ver avatar.css) */
    }
  }
  /* Por encima del retrato: el fundido de su borde inferior no debe tapar la primera línea. */
  /* flex: 999 1 460px: el texto se lleva casi todo el espacio libre. min-width: 0 evita que se desborde. */
  .about__text {
    position: relative;
    z-index: 1;
    flex: 999 1 460px;
    min-width: 0;
  }
  .about__eyebrow {
    margin: 0 0 10px;
    font-size: 15px;
    letter-spacing: 0.06em;
    color: var(--color-gold);
  }
  /* El título es una placa blanca inclinada, como las de P3R. */
  /*
   clamp(48px, 7vw, 92px): tamaño que crece con el ancho de pantalla pero nunca baja de 48 ni pasa de 92.
   clip-path recorta la placa con esquinas torcidas y rotate la inclina.
   */
  .about__title {
    display: inline-block;
    margin: 0 0 14px;
    padding: 6px 40px 10px 18px;
    background: var(--color-paper);
    color: var(--color-bg);
    font-size: clamp(48px, 7vw, 92px);
    line-height: 0.86;
    clip-path: polygon(0 10%, 100% 0, 96% 100%, 2% 92%);
    transform: rotate(-4deg);
    transform-origin: left top;
    margin-top: clamp(26px, 4vw, 44px);
  }
  .about__place {
    margin: 8px 0 18px;
    font-size: 14px;
    color: var(--color-mint);
  }
  .about__lead {
    margin: 0 0 10px;
    max-width: 56ch;
    font-size: 19px;
    line-height: 1.5;
    font-weight: 600;
  }
  .about__body {
    margin: 0 0 10px;
    max-width: 56ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-mint);
  }
  .about__h {
    margin: 0 0 14px;
    font-size: 32px;
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
  }
  .about__h--inline {
    margin: 0;
  }
  /* Cuadrícula responsive sin media queries: repeat(auto-fit, minmax(260px, 1fr)) mete tantas columnas de al menos 260 px como quepan. */
  .about__how {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .about__how-item {
    padding: 16px 18px;
    border: 1px solid rgba(232, 198, 106, 0.35);
    border-left: 0;
    background: rgba(232, 198, 106, 0.05);
    clip-path: polygon(0 0, 100% 4%, 98% 100%, 1% 96%);
  }
  .about__how-item b {
    display: block;
    margin-bottom: 6px;
    font-size: 18px;
  }
  .about__how-item span {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-mint);
  }
  /* Móvil: Now, Off the keyboard y «Let's talk» uno bajo otro. Escritorio: «Let's talk» va bajo Now,
     en el hueco que dejaba el recuadro de gustos (más alto) a la derecha. */
  /* grid-template-areas nombra las zonas. Móvil: now, off y next una bajo otra. En escritorio cambia con el media query de abajo. */
  .about__cols {
    display: grid;
    grid-template-areas: 'now' 'off' 'next';
    gap: 28px;
  }
  .about__now {
    grid-area: now;
    min-width: 0;
  }
  .about__next {
    grid-area: next;
    align-self: end;
  }
  /* Mobile first en acción: desde 768 px de ancho se pasa a dos columnas (2fr y 1fr) y a otra distribución de áreas. */
  @media (min-width: 768px) {
    .about__cols {
      grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
      grid-template-areas: 'now off' 'next off';
    }
  }
  .about__now-head {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 14px;
  }
  .about__menace {
    display: flex;
    gap: 4px;
  }
  .about__now-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
  }
  .about__now-row {
    display: flex;
    gap: 14px;
  }
  /* dt = etiqueta fija de 92 px a la izquierda; dd (siguiente regla) es el valor. */
  .about__now-row dt {
    flex: none;
    width: 92px;
    font-size: 12px;
    color: var(--color-gold);
  }
  .about__now-row dd {
    margin: 0;
  }
  /* Recuadro de borde punteado (dashed) con esquinas redondeadas. */
  .about__off {
    grid-area: off;
    align-self: start;
    padding: 18px 20px;
    border: 1px dashed rgba(232, 198, 106, 0.5);
    border-radius: 12px;
  }
  .about__off-title {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
  }
  .about__off-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.4;
  }
  .about__off-list dt {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .about__off-list dd {
    margin: 0;
    color: var(--color-mint);
  }
  /* Alineada con el texto de «Let's talk» (la opción tiene 14 px de margen interior). */
  /* Texto del CV aún no disponible: más tenue (opacity) y alineado con el texto del enlace de arriba. */
  .about__cv-soon {
    margin: 6px 0 0;
    padding-left: 14px;
    font-size: 14px;
    color: var(--color-mint);
    opacity: 0.7;
  }
  .about__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }
</style>
