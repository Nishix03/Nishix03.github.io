---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import PoseFigure from '../components/PoseFigure.astro';
import Sprite from '../components/Sprite.astro';
import { getContent } from '../content';

const { ui, journeyIntro, education, facts, milestones, diary, platzi } = getContent();
const page = ui.pages.journey;
---

<BaseLayout title={`${page.title} — ${ui.siteTitle}`}>
  <PageShell word={page.word} num={page.num} wordSize={240} wordTop={40} wordRight={-60}>
    <div class="journey__top">
      <div class="journey__intro">
        <h1 class="journey__title display fx-cascade">{page.title}</h1>
        <p class="journey__lead fx-cascade" style="animation-delay: .06s">
          {journeyIntro}
        </p>
        <div class="journey__facts fx-cascade" style="animation-delay: .12s">
          <div class="education">
            <div class="education__kicker mono">{education.kicker}</div>
            <div class="education__title">{education.title}</div>
            <div class="education__detail">{education.detail}</div>
          </div>
          {facts.map((fact) => (
            <div class="fact">
              <div class="fact__n">{fact.n}</div>
              <div class="fact__label">{fact.label}</div>
            </div>
          ))}
        </div>
      </div>
      <PoseFigure variant="journey" style="--pose-w:240px;--pose-h:320px;animation-delay:.18s" />
    </div>

    <div class="timeline">
      <!-- El personaje camina sobre la barra; LATEST marca el último hito alcanzado -->
      <div class="timeline__walker" aria-hidden="true" data-loop>
        <div class="fx-trek timeline__walker-track">
          <div class="fx-walk timeline__walker-box">
            3D
            <br />
            walk
          </div>
        </div>
      </div>
      <div class="latest" aria-hidden="true">
        <div class="latest__inner">LATEST</div>
      </div>
      <div class="timeline__menace" aria-hidden="true" data-loop>
        {[0, 1, 2].map((i) => (
          <div
            class="fx-menace timeline__menace-item"
            style={`margin-top:${i * -10}px;animation-delay:${i * 0.3}s`}
          >
            <Sprite sprite="menace" fallback="ゴ" />
          </div>
        ))}
      </div>

      <div class="timeline__bar">
        {milestones.map((milestone, i) => (
          <div
            class:list={['timeline__seg', 'fx-seg', { 'timeline__seg--locked': milestone.locked }]}
            style={`animation-delay:${(0.2 + i * 0.06).toFixed(2)}s`}
          />
        ))}
      </div>
      <ol class="timeline__cards">
        {milestones.map((milestone) => (
          <li>
            <div
              class:list={['milestone', { 'milestone--locked': milestone.locked }]}
              aria-disabled={milestone.locked ? 'true' : 'false'}
            >
              <span class="milestone__date mono">{milestone.date}</span>
              <span class="milestone__label">{milestone.label}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="journey__bottom">
      <article class="diary">
        <div class="diary__compass" aria-hidden="true" data-loop>
          <div class="fx-needle" style="position:absolute;inset:0;transform-origin:18px 18px">
            <Sprite sprite="compass" fallback="N" />
          </div>
        </div>
        <div>
          <p class="diary__kicker mono">{diary.kicker}</p>
          <h2 class="diary__title">{diary.title}</h2>
          <p class="diary__body">{diary.body}</p>
          <p class="diary__learned">{diary.learned}</p>
        </div>
      </article>
      <aside class="certs">
        <p class="certs__kicker mono">{platzi.kicker}</p>
        <ul class="certs__list">
          {platzi.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <a class="certs__cta" href={platzi.url} rel="noopener" target="_blank">
          {platzi.cta}
        </a>
      </aside>
    </div>
  </PageShell>
</BaseLayout>

<style>
  .journey__top {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-start;
  }
  .journey__intro {
    flex: 1 1 520px;
    min-width: 0;
  }
  .journey__title {
    margin: 0 0 6px;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 0.9;
  }
  .journey__lead {
    margin: 0 0 26px;
    color: var(--color-mint);
    font-size: 15px;
  }
  .journey__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 26px;
  }
  .education {
    min-width: 280px;
    padding: 16px 40px 16px 22px;
    background: var(--color-paper);
    color: var(--color-bg);
    clip-path: polygon(0 0, 100% 0, 96% 100%, 0 100%);
  }
  .education__kicker {
    font-size: 12px;
  }
  .education__title {
    margin-top: 2px;
    font-weight: 900;
    font-size: 24px;
    line-height: 1.15;
  }
  .education__detail {
    margin-top: 2px;
    font-size: 15px;
  }
  .fact {
    min-width: 120px;
    padding: 14px 20px;
    border: 1px solid rgba(168, 240, 200, 0.2);
    border-radius: 10px;
  }
  .fact__n {
    font-weight: 900;
    font-size: 28px;
    font-variant-numeric: tabular-nums;
  }
  .fact__label {
    max-width: 18ch;
    font-size: 13px;
    color: var(--color-mint);
  }

  .timeline {
    position: relative;
    padding-top: 90px;
  }
  .timeline__walker {
    position: absolute;
    left: 0;
    top: 0;
    width: 66%;
    height: 64px;
  }
  .timeline__walker-track {
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(100% - 48px);
    height: 60px;
  }
  .timeline__walker-box {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 48px;
    height: 60px;
    display: grid;
    place-items: center;
    border: 2px dashed rgba(168, 240, 200, 0.6);
    background: rgba(73, 224, 240, 0.12);
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--color-mint);
    text-align: center;
    line-height: 1.1;
  }
  .latest {
    position: absolute;
    left: calc(66% - 40px);
    top: -8px;
    padding: 3px;
    background: var(--sel);
    clip-path: polygon(4% 18%, 100% 0, 94% 100%, 0 86%);
  }
  .latest__inner {
    padding: 8px 24px;
    background: var(--color-paper);
    color: var(--color-bg);
    font-weight: 900;
    font-style: italic;
    font-size: 20px;
    clip-path: polygon(4% 18%, 100% 0, 94% 100%, 0 86%);
  }
  .timeline__menace {
    position: absolute;
    left: calc(66% + 120px);
    top: -4px;
    display: flex;
    gap: 6px;
  }
  .timeline__menace-item {
    position: relative;
    width: 40px;
    height: 24px;
  }
  .timeline__bar {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 4px;
    height: 18px;
  }
  .timeline__seg {
    background: var(--color-neon);
  }
  .timeline__seg--locked {
    background: rgba(168, 240, 200, 0.12);
  }
  .timeline__cards {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
    gap: 8px;
  }
  .milestone {
    min-height: 96px;
    padding: 12px;
    text-align: left;
    background: rgba(168, 240, 200, 0.06);
    color: var(--color-ink);
    border: 1px solid rgba(57, 255, 136, 0.45);
    border-radius: 10px;
  }
  .milestone--locked {
    background: transparent;
    color: #8fb3a0;
    border-color: rgba(168, 240, 200, 0.15);
  }
  .milestone__date {
    display: block;
    font-size: 11px;
    opacity: 0.85;
  }
  .milestone__label {
    display: block;
    margin-top: 6px;
    font-weight: 800;
    font-size: 14px;
    line-height: 1.3;
  }

  .journey__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 26px;
  }
  .diary {
    flex: 2 1 480px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 20px 22px;
    border: 1px solid rgba(57, 255, 136, 0.4);
    border-radius: 12px;
    background: rgba(57, 255, 136, 0.05);
  }
  .diary__compass {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
  }
  .diary__kicker {
    margin: 0 0 6px;
    font-size: 13px;
    color: var(--color-neon);
  }
  .diary__title {
    margin: 0 0 8px;
    font-size: 21px;
    font-weight: 900;
  }
  .diary__body {
    margin: 0 0 8px;
    font-size: 15px;
    line-height: 1.55;
  }
  .diary__learned {
    margin: 0;
    font-size: 15px;
    color: var(--color-mint);
  }
  .certs {
    flex: 1 1 280px;
    padding: 20px 22px;
    border: 1px solid rgba(168, 240, 200, 0.2);
    border-radius: 12px;
  }
  .certs__kicker {
    margin: 0 0 10px;
    font-size: 13px;
    color: var(--color-neon);
  }
  .certs__list {
    margin: 0 0 16px;
    padding-left: 18px;
    list-style: disc;
    font-size: 15px;
    line-height: 1.6;
  }
  .certs__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    background: var(--color-neon);
    color: var(--color-bg);
    font-weight: 800;
    text-decoration: none;
    border-radius: 6px;
  }
</style>
