---
// PÁGINA JOURNEY (/journey) - mi trayectoria: estudios, datos clave, línea de tiempo de hitos, diario y certificados.
// RUTAS POR ARCHIVO EN ASTRO: journey.astro = URL /journey; la versión /es/journey está en pages/es/journey.astro.
// FRONTMATTER: este código corre al construir la página (no en el navegador) y prepara los datos del HTML.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import AvatarCutin from '../components/AvatarCutin.astro';
import Sprite from '../components/Sprite.astro';
import { getContent, localeFromUrl, localePath } from '../content';

// localeFromUrl lee la URL y dice si estamos en inglés o español (/es/). Aquí solo se calcula; no se usa más abajo.
const locale = localeFromUrl(Astro.url);
// getContent(locale) devuelve los textos en ese idioma: education = estudios, facts = datos con número,
// milestones = hitos de la línea de tiempo (algunos locked = aún no alcanzados), diary = entrada de diario, platzi = cursos/certificados.
const { ui, journeyIntro, education, facts, milestones, diary, platzi } = getContent(locale);
// Título, palabra grande de fondo y número de sección de esta página.
const page = ui.pages.journey;
---

<!-- BaseLayout = marco común (head, menú, fuentes). El título usa plantilla de texto con ${...}. -->
<BaseLayout title={`${page.title} — ${ui.siteTitle}`}>
  <!-- PageShell = carcasa de páginas interiores (palabra gigante de fondo + número de sección). -->
  <PageShell word={page.word} num={page.num} wordSize={240} wordTop={40} wordRight={-60}>
    <!-- El avatar va en el slot "bg" (fondo) de PageShell. -->
    <AvatarCutin slot="bg" page="journey" />
    <!-- PARTE SUPERIOR: título, frase de introducción, estudios (education) y datos clave (facts). BEM: journey__ y education__ / fact__. -->
    <div class="journey__top">
      <div class="journey__intro">
        <h1 class="journey__title display fx-cascade">{page.title}</h1>
        <p class="journey__lead fx-cascade" style="animation-delay: .06s">
          {journeyIntro}
        </p>
        <div class="journey__facts fx-cascade" style="animation-delay: .12s">
          <div class="education">
            <div class="education__kicker mono">{education.kicker}</div>
            <div class="education__title">{education.title}</div>
            <div class="education__detail">{education.detail}</div>
          </div>
          {facts.map((fact) => (
            <div class="fact">
              <div class="fact__n">{fact.n}</div>
              <div class="fact__label">{fact.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- LÍNEA DE TIEMPO: personaje que camina, marca LATEST, barra de 9 segmentos y tarjetas de hitos. -->
    <div class="timeline">
      <!-- El personaje camina sobre la barra; LATEST marca el último hito alcanzado -->
      <!-- Adorno animado (aria-hidden). data-loop es un data-attribute que el JS global usa como marca de animación infinita. -->
      <div class="timeline__walker" aria-hidden="true" data-loop>
        <!-- Mini Iván camina por el carril de hitos al ritmo del Iván grande: la tira dibuja dos pasos en
             2,4 s (el balanceo del grande) y el carril lo desplaza de izquierda a derecha. -->
        <div class="fx-trek timeline__walker-track">
          <!-- Pisada neón, como la de Springtrap: un destello bajo los pies en cada paso (2 por ciclo de 800 ms). -->
          <span class="timeline__step"></span>
          <span class="timeline__walker-box">
            <img
              class="cutin__strip timeline__walker-strip"
              src="/avatar/journey-walk.webp"
              alt=""
              width="768"
              height="128"
              decoding="async"
              style="--d:2400ms;--n:8;--e:-87.5%;--w:1.3s"
            />
          </span>
        </div>
      </div>
      <div class="latest" aria-hidden="true">
        <div class="latest__inner">LATEST</div>
      </div>
      <!-- Tres sprites que se repiten con map. Cada uno cambia su retraso (i * 0.3 s) para que no vayan a la vez. -->
      <div class="timeline__menace" aria-hidden="true" data-loop>
        {[0, 1, 2].map((i) => (
          <div
            class="fx-menace timeline__menace-item"
            style={`margin-top:${i * -10}px;animation-delay:${i * 0.3}s`}
          >
            <Sprite sprite="menace" fallback="ゴ" />
          </div>
        ))}
      </div>

      <!-- Leyenda: cuenta los hitos NO bloqueados (filter) sobre el total. Ej.: 6 / 9. -->
      <p class="timeline__legend mono" aria-hidden="true">{milestones.filter((m) => !m.locked).length} / {milestones.length} {ui.milestones}</p>
      <!--
        Barra: un segmento por hito; los bloqueados (locked) salen apagados con el modificador BEM timeline__seg--locked.
        class:list es una utilidad de Astro para clases condicionales.
      -->
      <div class="timeline__bar">
        {milestones.map((milestone, i) => (
          <div
            class:list={['timeline__seg', 'fx-seg', { 'timeline__seg--locked': milestone.locked }]}
            style={`animation-delay:${(0.2 + i * 0.06).toFixed(2)}s`}
          />
        ))}
      </div>
      <!--
        Tarjetas de hitos (lista ordenada ol, porque el orden importa). La primera bloqueada lleva una clase extra: en móvil
        muestra el rótulo "Next" leído de data-label con content: attr(data-label) en CSS. aria-disabled marca los hitos bloqueados.
      -->
      <ol class="timeline__cards">
        {milestones.map((milestone, i) => (
          <li
            class:list={{ 'timeline__first-locked': milestone.locked && !milestones[i - 1]?.locked }}
            data-label={ui.nextLocked}
          >
            <div
              class:list={['milestone', { 'milestone--locked': milestone.locked }]}
              aria-disabled={milestone.locked ? 'true' : 'false'}
            >
              <span class="milestone__date mono">{milestone.date}</span>
              <span class="milestone__label">{milestone.label}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- PARTE INFERIOR: diario (article) y certificados (aside = contenido complementario). -->
    <div class="journey__bottom">
      <!-- Entrada de diario: brújula animada + texto + enlace externo (target="_blank" con rel="noopener noreferrer" por seguridad). -->
      <article class="diary">
        <div class="diary__compass" aria-hidden="true" data-loop>
          <div class="fx-needle" style="position:absolute;inset:0;transform-origin:18px 18px">
            <Sprite sprite="compass" fallback="N" />
          </div>
        </div>
        <div>
          <p class="diary__kicker mono">{diary.kicker}</p>
          <h2 class="diary__title">{diary.title}</h2>
          <p class="diary__body">
            {diary.body}
            <a class="diary__link" href={diary.link.href} target="_blank" rel="noopener noreferrer">{diary.link.label}</a>
          </p>
          <p class="diary__learned">{diary.learned}</p>
        </div>
      </article>
      <!-- Certificados de Platzi: lista de cursos y botón al perfil. -->
      <aside class="certs">
        <p class="certs__kicker mono">{platzi.kicker}</p>
        <ul class="certs__list">
          {platzi.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <a class="certs__cta" href={platzi.url} rel="noopener" target="_blank">
          {platzi.cta}
        </a>
      </aside>
    </div>
  </PageShell>
</BaseLayout>

<style>
  /*
   ESTILOS DE ESTA PÁGINA (scoped: solo afectan a este archivo; :global solo si hiciera falta).
   BEM: journey__, timeline__, milestone__, diary__, certs__. Colores y fuentes salen de variables CSS (var(--color-...)).
   Mobile first: la base es para móvil y @media (min-width: 1024px) añade el diseño de escritorio;
   el bloque de max-width: 767px aplica solo a móvil (línea de tiempo vertical).
   */
  /* Escritorio: arriba los datos dejan libre la cara del avatar; la línea de tiempo y el resto, que
     van por debajo de su fundido, ocupan todo el ancho (sin hueco a la derecha). */
  /* Escritorio: la parte superior limita su ancho (deja ver la cara del avatar) y los 9 hitos van en una fila de 9 columnas. */
  @media (min-width: 1024px) {
    .journey__top {
      max-width: 860px;
    }
    .journey__top + .timeline,
    .timeline,
    .journey__bottom {
      position: relative;
      z-index: 1;
      max-width: none;
    }
    /* Los 9 hitos en una sola fila, alineados con los 9 segmentos de la barra (sin huérfanos). */
    .timeline .timeline__cards {
      grid-template-columns: repeat(9, minmax(0, 1fr));
    }
  }
  /* Pantallas medianas: tarjetas más estrechas, texto algo menor para que no toque el borde. */
  /* Rango intermedio (1024-1279 px): tarjetas más estrechas, texto algo menor. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .timeline .milestone {
      padding: 10px 8px;
    }
    .timeline .milestone__label {
      font-size: 13px;
      overflow-wrap: anywhere;
    }
  }
  @media (min-width: 1024px) {
    /* LATEST y ゴゴゴ justo encima del sexto hito (el último alcanzado), a la altura de mini Iván,
       en vez de flotar arriba sobre el avatar. 66,67 % = 6 de 9 segmentos. */
    .timeline .latest {
      left: auto;
      right: calc(33.33% + 8px);
      top: 96px;
    }
    .timeline .timeline__menace {
      left: calc(66.67% + 10px);
      top: 104px;
    }
    .timeline {
      padding-top: 150px;
    }
  }
  .journey__top {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-start;
  }
  .journey__intro {
    flex: 1 1 520px;
    min-width: 0;
  }
  /* clamp(44px, 7vw, 84px): la fuente crece con la pantalla pero con mínimo y máximo. */
  .journey__title {
    margin: 0 0 6px;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 0.9;
  }
  .journey__lead {
    margin: 0 0 26px;
    color: var(--color-mint);
    font-size: 15px;
  }
  @media (max-width: 767px) {
    /* El marcador «3D walk» (aún sin sprite) se oculta en móvil: suelto parece un resto. */
    .journey__intro .journey__facts {
      display: grid;
      align-items: stretch;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .journey__intro .education {
      grid-column: 1 / -1;
      min-width: 0;
    }
    .journey__intro .fact {
      min-width: 0;
    }
  }
  .journey__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 26px;
  }
  .education {
    min-width: 280px;
    padding: 16px 40px 16px 22px;
    background: var(--color-paper);
    color: var(--color-bg);
    clip-path: polygon(0 0, 100% 0, 96% 100%, 0 100%);
  }
  .education__kicker {
    font-size: 12px;
  }
  .education__title {
    margin-top: 2px;
    font-weight: 900;
    font-size: 24px;
    line-height: 1.15;
  }
  .education__detail {
    margin-top: 2px;
    font-size: 15px;
  }
  .fact {
    min-width: 120px;
    background: #0f1c15;
    padding: 14px 20px;
    border: 1px solid rgba(168, 240, 200, 0.2);
    border-radius: 10px;
  }
  .fact__n {
    font-weight: 900;
    font-size: 28px;
    font-variant-numeric: tabular-nums;
  }
  .fact__label {
    max-width: 18ch;
    font-size: 13px;
    color: var(--color-mint);
  }

  .timeline {
    position: relative;
    padding-top: 150px;
  }
  .timeline__walker {
    position: absolute;
    left: 0;
    top: 0;
    width: 66%;
    height: 152px; /* los pies (ancla de suelo) quedan sobre la barra */
  }
  /* Carril por el que avanza mini Iván; la animación (fx-trek) viene de los estilos globales. */
  .timeline__walker-track {
    animation-duration: 33s; /* tres veces más lento que antes, como sus pasos */
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(100% - 96px);
    height: 128px;
  }
  /* Cuadro de 96×128 (la rejilla lógica 192×256 a la mitad) con la tira de 8 poses dentro. */
  .timeline__walker-box {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 96px;
    height: 128px;
    overflow: hidden;
  }
  .timeline__walker-strip {
    width: 800%;
    height: 100%;
  }
  /* Animación propia: @keyframes walker-step define los pasos (0 % a 100 %) que luego se usan en la propiedad animation. */
  /* Solo transform y opacity: la sombra es fija y el compositor anima el destello sin repintar. */
  .timeline__step {
    position: absolute;
    left: 48px;
    bottom: 2px;
    width: 60px;
    height: 10px;
    margin-left: -30px;
    border-radius: 50%;
    background: radial-gradient(closest-side, #b8ffd6, var(--color-neon) 45%, rgba(57, 255, 136, 0));
    box-shadow:
      0 0 12px var(--color-neon),
      0 0 24px rgba(57, 255, 136, 0.55);
    opacity: 0;
    animation: walker-step 1200ms var(--ease-p3r) 1.3s infinite;
  }
  /* Destello en el primer tercio del paso (cuando apoya el pie) y quieto el resto. */
  @keyframes walker-step {
    0% {
      opacity: 1;
      transform: scale(0.5);
    }
    33%,
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }
  /* Accesibilidad: si el usuario pidió menos movimiento en su sistema, se oculta el destello animado. */
  @media (prefers-reduced-motion: reduce) {
    .timeline__step {
      display: none;
    }
  }
  .latest {
    position: absolute;
    left: calc(66% - 40px);
    top: -8px;
    padding: 3px;
    background: var(--sel);
    clip-path: polygon(4% 18%, 100% 0, 94% 100%, 0 86%);
  }
  .latest__inner {
    padding: 8px 24px;
    background: var(--color-paper);
    color: var(--color-bg);
    font-weight: 900;
    font-style: italic;
    font-size: 20px;
    clip-path: polygon(4% 18%, 100% 0, 94% 100%, 0 86%);
  }
  .timeline__menace {
    position: absolute;
    left: calc(66% + 120px);
    top: -4px;
    display: flex;
    gap: 6px;
  }
  .timeline__menace-item {
    position: relative;
    width: 40px;
    height: 24px;
  }
  .timeline__legend {
    position: absolute;
    right: 0;
    top: 126px;
    margin: 0;
    font-size: 12px;
    color: var(--color-mint);
  }
  /* grid con repeat(9, minmax(0, 1fr)): 9 columnas iguales, una por hito. */
  .timeline__bar {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 4px;
    height: 18px;
  }
  .timeline__seg {
    background: var(--color-neon);
  }
  .timeline__seg--locked {
    background: rgba(168, 240, 200, 0.12);
  }
  /* Los pseudo-elementos ::before y ::after dibujan los cuadritos de la línea y el rótulo sin añadir HTML. */
  /* Móvil: línea de tiempo vertical (una columna, cronológica); los bloqueados se agrupan bajo «Next». */
  @media (max-width: 767px) {
    .timeline .timeline__cards {
      grid-template-columns: 1fr;
      gap: 0;
      margin-left: 6px;
      border-left: 2px solid rgba(57, 255, 136, 0.45);
    }
    .timeline .timeline__cards li {
      position: relative;
      padding: 0 0 10px 18px;
    }
    .timeline .timeline__cards li::before {
      content: '';
      position: absolute;
      left: -7px;
      top: 18px;
      width: 12px;
      height: 12px;
      background: var(--color-neon);
    }
    .timeline .timeline__cards .timeline__first-locked {
      margin-top: 24px;
    }
    .timeline .timeline__cards .timeline__first-locked::after {
      content: attr(data-label);
      position: absolute;
      left: 18px;
      top: -22px;
      font-family: var(--font-pixel);
      font-size: 12px;
      color: var(--color-mint);
    }
    .timeline .timeline__cards li:has(.milestone--locked)::before {
      background: var(--color-bg);
      border: 2px solid rgba(168, 240, 200, 0.4);
    }
    .timeline .milestone {
      min-height: 0;
    }
    .milestone__date {
      font-size: 13px;
    }
    .diary__link {
      display: block;
      margin-top: 10px;
      padding: 10px 0;
    }
  }
  /* Base: auto-fit con minmax(118px, 1fr) = tantas columnas como quepan. En móvil se pasa a 1 columna; en escritorio a 9. */
  .timeline__cards {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
    gap: 8px;
  }
  .milestone {
    min-height: 96px;
    padding: 12px;
    text-align: left;
    background: #12231a;
    color: var(--color-ink);
    border: 1px solid rgba(57, 255, 136, 0.45);
    border-radius: 10px;
  }
  /* Modificador BEM: hito aún no alcanzado, con colores apagados. */
  .milestone--locked {
    background: var(--color-bg);
    color: #8fb3a0;
    border-color: rgba(168, 240, 200, 0.15);
  }
  .milestone__date {
    display: block;
    font-size: 11px;
    opacity: 0.85;
  }
  .milestone__label {
    display: block;
    margin-top: 6px;
    font-weight: 800;
    font-size: 14px;
    line-height: 1.3;
  }

  .journey__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 26px;
  }
  .diary {
    flex: 2 1 480px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 20px 22px;
    border: 1px solid rgba(57, 255, 136, 0.4);
    border-radius: 12px;
    background: #0c1d14;
  }
  .diary__compass {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
  }
  .diary__kicker {
    margin: 0 0 6px;
    font-size: 13px;
    color: var(--color-neon);
  }
  .diary__title {
    margin: 0 0 8px;
    font-size: 21px;
    font-weight: 900;
  }
  .diary__body {
    margin: 0 0 8px;
    font-size: 15px;
    line-height: 1.55;
  }
  .diary__link {
    margin-left: 6px;
    color: var(--color-neon);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .diary__learned {
    margin: 0;
    font-size: 15px;
    color: var(--color-mint);
  }
  .certs {
    flex: 1 1 280px;
    background: var(--color-bg);
    padding: 20px 22px;
    border: 1px solid rgba(168, 240, 200, 0.2);
    border-radius: 12px;
  }
  .certs__kicker {
    margin: 0 0 10px;
    font-size: 13px;
    color: var(--color-neon);
  }
  .certs__list {
    margin: 0 0 16px;
    padding-left: 18px;
    list-style: disc;
    font-size: 15px;
    line-height: 1.6;
  }
  .certs__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    background: var(--color-neon);
    color: var(--color-bg);
    font-weight: 800;
    text-decoration: none;
    border-radius: 6px;
  }
</style>
