---
// PÁGINA STACK (/stack) - las tecnologías que uso, con porcentaje de dominio, evidencia y ranking.
// RUTAS POR ARCHIVO EN ASTRO: stack.astro = URL /stack; la versión /es/stack está en pages/es/stack.astro.
// FRONTMATTER: este código corre al construir la página (no en el navegador); prepara los datos para el HTML.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/PageShell.astro';
import AvatarCutin from '../components/AvatarCutin.astro';
import Sprite from '../components/Sprite.astro';
import { getContent, localeFromUrl, localePath } from '../content';
import { techIconSlot } from '../sprites/manifest';

// localeFromUrl lee la URL y dice si estamos en inglés o español (/es/).
const locale = localeFromUrl(Astro.url);
// getContent(locale) devuelve los textos en ese idioma. stack = lista de tecnologías (id, name, percent, rank, evidence...),
// stackIntro = párrafo de introducción, ui = textos generales.
const { stack, stackIntro, ui } = getContent(locale);
// Título, palabra grande de fondo y número de sección de esta página.
const page = ui.pages.stack;

// segments() construye la barra de nivel de una tarjeta: 10 cuadritos; encendidos (on) los primeros round(percent / 10).
// Ejemplo: 80 % = 8 encendidos. Array.from({ length: 10 }, ...) crea un arreglo de 10 elementos.
// delay escalona la animación de llenado (más tarde cuanto mayor la tarjeta y el segmento).
// 10 segmentos que se llenan con scaleX (A23): 20 ms entre segmento y 40 ms entre tarjetas.
const segments = (percent: number, tileIndex: number) =>
  Array.from({ length: 10 }, (_, j) => ({
    on: j < Math.round(percent / 10),
    delay: (0.3 + tileIndex * 0.04 + j * 0.02).toFixed(2),
  }));
---

<!-- BaseLayout = marco común (head, menú, fuentes). El título usa plantilla de texto con ${...}. -->
<BaseLayout title={`${page.title} — ${ui.siteTitle}`}>
  <!-- PageShell = carcasa de páginas interiores (palabra gigante de fondo + número de sección). Las props ajustan tamaño y posición. -->
  <PageShell word={page.word} num={page.num} wordSize={260} wordTop={40} wordRight={-60} minHeight={900}>
    <!-- El avatar va en el slot "bg" (fondo) de PageShell. -->
    <AvatarCutin slot="bg" page="stack" />
    <div class="stack__head fx-cascade">
      <h1 class="stack__title display">{page.title}</h1>
    </div>
    <p class="stack__intro fx-cascade" style="animation-delay: .06s">
      {stackIntro}
    </p>

    <div class="stack__layout">
      <!--
        CUADRÍCULA DE TARJETAS. BEM: tile = bloque de cada tecnología; tile__icon, tile__body... = sus elementos.
        Se crea una tarjeta por tecnología con stack.map(). fx-cascade las anima en cascada (retraso creciente con i).
        Sprite pinta el icono de la tecnología o, si no hay, el texto de respaldo (fallback).
      -->
      <ul class="stack__grid">
        {stack.map((tech, i) => (
          <li class="tile fx-cascade" style={`animation-delay: ${(0.1 + i * 0.04).toFixed(2)}s`}>
            <span class="tile__icon" aria-hidden="true">
              <Sprite
                sprite={techIconSlot(tech.id)}
                fallback={tech.code}
                background={tech.background}
                color={tech.foreground}
              />
            </span>
            <span class="tile__body">
              <span class="tile__top">
                <span class="tile__name">{tech.name}</span>
                <span class="tile__percent">{tech.percent}%</span>
              </span>
              <!--
                Barra de nivel: role="img" + aria-label la describen a lectores de pantalla (de otro modo serían solo 10 cuadritos mudos).
                class:list es una utilidad de Astro para armar clases condicionales: tile__seg--on (modificador BEM) solo en los segmentos encendidos.
              -->
              <span
                class="tile__bar"
                role="img"
                aria-label={`${tech.name} ${tech.percent} percent`}
              >
                {segments(tech.percent, i).map((segment) => (
                  <span
                    class:list={['tile__seg', 'fx-seg', { 'tile__seg--on': segment.on }]}
                    style={`animation-delay:${segment.delay}s`}
                  />
                ))}
              </span>
              <span class="tile__evidence">{tech.evidence}</span>
            </span>
            <span class="tile__rank mono">R{tech.rank}</span>
          </li>
        ))}
      </ul>
    </div>

  </PageShell>
</BaseLayout>

<style>
  /* ESTILOS DE ESTA PÁGINA (scoped: solo afectan a este archivo). BEM: stack__ y tile__. Colores y fuentes salen de variables CSS. */
  .stack__head {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 6px;
  }
  /* clamp(44px, 7vw, 84px): la fuente crece con el ancho de pantalla pero con mínimo y máximo. */
  .stack__title {
    margin: 0;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 0.9;
  }
  .stack__intro {
    margin: 0 0 18px;
    max-width: 70ch;
    color: var(--color-mint);
    font-size: 15px;
    line-height: 1.5;
  }
  /* Mobile first: desde 1024 px se limita el ancho a 780 px para dejar ver el avatar de fondo. */
  @media (min-width: 1024px) {
    .stack__layout {
      max-width: 780px;
    }
  }
  .stack__layout {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    margin-top: 28px;
    align-items: flex-start;
  }
  /* grid con repeat(auto-fill, minmax(250px, 1fr)): tantas columnas de al menos 250 px como quepan; sin media queries. */
  .stack__grid {
    flex: 1 1 520px;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 12px;
  }

  /* Tarjeta de una tecnología: flex con el icono, el cuerpo y el rango (R1, R2...). */
  .tile {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: #0f1c15;
    border: 1px solid rgba(168, 240, 200, 0.14);
    border-radius: 12px;
  }
  .tile__icon {
    flex: none;
    outline: 2px solid var(--color-surface);
  }
  .tile__body {
    flex: 1;
    min-width: 0;
  }
  .tile__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .tile__name {
    font-weight: 800;
    font-size: 16px;
  }
  .tile__percent {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    font-size: 14px;
    color: var(--color-neon);
  }
  .tile__bar {
    display: flex;
    gap: 2px;
    width: 100px;
    height: 6px;
    margin-top: 6px;
  }
  .tile__seg {
    flex: 1;
    background: rgba(168, 240, 200, 0.15);
  }
  /* Modificador BEM: segmento encendido (color neón). Los apagados usan el fondo tenue de .tile__seg. */
  .tile__seg--on {
    background: var(--color-neon);
  }
  .tile__evidence {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    color: var(--color-mint);
  }
  .tile__rank {
    flex: none;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--color-mint);
    color: var(--color-bg);
    font-size: 13px;
  }
</style>
