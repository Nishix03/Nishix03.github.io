---
/**
 * Cabecera fija del sitio: marca (IVÁN RODAS), menú de navegación, botón del chat NishixAI y
 * selector de idioma. Se usa una sola vez, dentro de src/layouts/BaseLayout.astro, así que
 * aparece en todas las páginas. No recibe props: todo lo saca de la URL y del contenido.
 *
 * Concepto nuevo: ISLA DE REACT. Astro genera HTML sin JavaScript. Cuando necesitamos algo
 * interactivo de React (el chat), lo incrustamos como "isla" y le ponemos una directiva
 * `client:*` para que se cargue solo ese trozo en el navegador.
 */
import NishixChat from './NishixChat';
import LangSwitch from './LangSwitch.astro';
import { getContent, localeFromUrl, localePath } from '../content';
import { sprites } from '../sprites/manifest';

// 1) ¿En qué idioma estamos? Se deduce de la URL (/en/..., /es/...).
const locale = localeFromUrl(Astro.url);
// 2) Textos de ese idioma: `ui` (menú, etiquetas), `chat` (textos del chat) y las preguntas rápidas.
const { ui, chat, chatQuestions } = getContent(locale);
// 3) Ruta actual sin la barra final ("/es/stack/" -> "/es/stack"); si queda vacía, es "/".
//    Sirve para saber qué enlace del menú es la página actual (aria-current).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// 4) Icono pixel del chat. Si todavía no está listo (`ready`), el chat muestra las letras NX.
const icon = sprites.iconNishixAI;
---

<!-- <header> es una "landmark" (zona con significado) para lectores de pantalla. BEM: header__elemento. -->
<header class="header">
  <div class="header__bar">
    <!-- Marca: enlaza al inicio del idioma actual. `focus-ring` es una clase global para el foco con teclado. -->
    <a class="header__brand focus-ring" href={localePath(locale)}>
      IVÁN RODAS <span class="header__handle mono">{ui.handle}</span>
    </a>

    <!--
      Botón de menú (solo se ve en móvil). Atributos ARIA (accesibilidad):
      - aria-expanded: dice si el menú está abierto (true) o cerrado (false); el script de abajo lo actualiza.
      - aria-controls: indica qué elemento controla (el <nav id="site-menu">).
      Las tres barras del icono se dibujan solo con CSS (aria-hidden: son decoración).
      El texto cambia entre data-closed ("Menú") y data-open ("Cerrar").
    -->
    <button
      class="header__toggle focus-ring"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="header__toggle-bars" aria-hidden="true"></span>
      <span class="header__toggle-text" data-closed={ui.menu} data-open={ui.close}>{ui.menu}</span>
    </button>

    <!-- Navegación principal. aria-label le pone nombre a la zona para lectores de pantalla. -->
    <nav class="header__nav" id="site-menu" aria-label={ui.mainNav}>
      <!-- Un enlace por apartado; .map() repite el bloque para cada elemento de ui.nav. -->
      {ui.nav.map((item) => (
        <a
          class="option header__link"
          href={localePath(locale, `/${item.page}`)}
          aria-current={path === localePath(locale, `/${item.page}`) ? 'page' : undefined}
        >
          <span class="option__slash" aria-hidden="true" />
          <span class="option__plate" aria-hidden="true" />
          <span class="option__label">{item.label}</span>
        </a>
      ))}
      <!-- En móvil el idioma va dentro del menú -->
      <LangSwitch extra="lang--menu" />
    </nav>

    <!--
      Herramientas: chat y idioma (en escritorio). Directivas del chat:
      - client:idle -> hidrata (activa) la isla de React cuando el navegador está libre, sin frenar la carga.
      - transition:persist -> con ClientRouter, el chat NO se destruye al cambiar de página y conserva la
        conversación; el nombre incluye el idioma para que cada idioma tenga su propio chat.
      Todo lo demás son props con textos ya traducidos.
    -->
    <div class="header__tools">
      <NishixChat
        client:idle
        transition:persist={`nishixai-${locale}`}
        title={chat.title}
        subtitle={chat.subtitle}
        greeting={chat.greeting}
        fallback={chat.fallback}
        placeholder={chat.placeholder}
        inputLabel={chat.inputLabel}
        questions={chatQuestions}
        iconSrc={icon.ready ? `/sprites/${icon.file}` : undefined}
      />
      <LangSwitch extra="lang--bar" />
    </div>
  </div>
</header>

<!--
  Estilos con BEM y mobile first: lo de arriba vale para móvil y los @media (min-width) lo adaptan a
  pantallas grandes. Aquí hay además un bloque (max-width: 1023px) con los ajustes específicos del
  menú desplegable móvil. Variables CSS (--color-*, --gutter) vienen de src/styles/global.css.
  En el bloque de estilos de Astro el CSS es "scoped" (solo afecta a este componente); por eso se usa :global()
  para llegar a clases de otro componente (.lang de LangSwitch).
-->
<style>
  /* Cabecera pegajosa (sticky): se queda arriba al hacer scroll, por encima del contenido (z-index). */
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(7, 17, 12, 0.9);
    border-bottom: 1px solid rgba(168, 240, 200, 0.12);
  }
  .header__bar {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding: 10px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }
  .header__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink);
    font-weight: 900;
    font-style: italic;
    font-size: 18px;
    text-decoration: none;
  }
  .header__handle {
    margin-left: 6px;
    font-style: normal;
    font-weight: 400;
    font-size: 13px;
    color: var(--color-mint);
  }
  /* 40 px entre opciones: el tajo de una no puede tocar a la siguiente. */
  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
  }
  .header__link {
    font-size: 20px;
    color: var(--color-ink);
  }
  .header__tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  /* El botón de menú está oculto por defecto; solo se muestra en el bloque móvil de más abajo. */
  .header__toggle {
    display: none;
  }
  /* Escritorio: todo en una fila (marca, 5 apartados, NishixAI e idioma), también con los textos en español. */
  @media (min-width: 1024px) {
    .header__bar {
      flex-wrap: nowrap;
    }
    .header__nav {
      flex-wrap: nowrap;
      gap: 4px 14px;
    }
    .header__link {
      font-size: 15px;
      white-space: nowrap;
    }
  }
  @media (min-width: 1280px) {
    .header__nav {
      gap: 4px 24px;
    }
    .header__link {
      font-size: 18px;
    }
  }
  /* En escritorio el idioma va en la barra; el del menú solo aparece en móvil. */
  .header__nav :global(.lang--menu) {
    display: none;
  }

  /* Móvil (mobile first): barra de una fila (marca, NishixAI, Menu) y los apartados en un panel
     que se abre con el botón. Cada enlace del panel mide 48 px de alto para tocarlo sin fallar. */
  @media (max-width: 1023px) {
    .header__bar {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0 4px;
      padding-block: 6px;
    }
    .header__brand {
      order: 1;
      flex: 0 0 auto;
      font-size: 14px;
      white-space: nowrap;
    }
    .header__handle {
      display: none;
    }
    .header__tools {
      order: 2;
      margin-left: auto;
      gap: 0;
      min-width: 0;
    }
    .header__tools :global(.lang) {
      display: none;
    }
    .header__nav :global(.lang--menu) {
      display: flex;
      align-self: flex-start;
      margin-top: 8px;
    }
    .header__toggle {
      order: 3;
      flex: none;
      margin-left: 8px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-width: 44px;
      min-height: 44px;
      padding: 0 12px;
      border: 1px solid rgba(168, 240, 200, 0.35);
      border-radius: 8px;
      background: transparent;
      color: var(--color-ink);
      font-weight: 800;
      font-size: 14px;
    }
    .header__toggle-bars,
    .header__toggle-bars::before,
    .header__toggle-bars::after {
      display: block;
      width: 18px;
      height: 2px;
      background: currentColor;
    }
    .header__toggle-bars {
      position: relative;
    }
    .header__toggle-bars::before,
    .header__toggle-bars::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .header__toggle-bars::before {
      top: -6px;
    }
    .header__toggle-bars::after {
      top: 6px;
    }
    /* En pantallas muy estrechas el botón queda solo con el icono; la palabra sigue para lectores de pantalla. */
    @media (max-width: 479px) {
      .header__toggle {
        padding: 0 13px;
      }
      .header__toggle-text {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    }
    /* El panel flota bajo la barra (no empuja la página) con fondo sólido y sombra. */
    .header__nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      display: none;
      flex-direction: column;
      gap: 0;
      padding: 4px var(--gutter) 12px;
      background: var(--color-bg);
      border-bottom: 1px solid rgba(168, 240, 200, 0.25);
      box-shadow: 0 18px 30px rgba(0, 0, 0, 0.55);
    }
    .header__bar[data-open='true'] .header__nav {
      display: flex;
    }
    /* Abierto: las tres barras pasan a ✕ y la etiqueta a «Close». */
    .header__bar[data-open='true'] .header__toggle-bars {
      background: transparent;
    }
    .header__bar[data-open='true'] .header__toggle-bars::before {
      top: 0;
      transform: rotate(45deg);
    }
    .header__bar[data-open='true'] .header__toggle-bars::after {
      top: 0;
      transform: rotate(-45deg);
    }
    .header__link {
      min-height: 48px;
      font-size: 24px;
    }
  }
</style>

<!--
  Este bloque de script corre en el NAVEGADOR (a diferencia del frontmatter, que corre al construir la web).
  Astro lo empaqueta como módulo. Menú móvil: el estado (abierto/cerrado) se guarda en un atributo
  data-open de la barra y el CSS lo usa para mostrar el panel.
-->
<script>
  /** Menú móvil: botón con aria-expanded; Esc lo cierra y devuelve el foco; al elegir un enlace se cierra. */
  const setup = () => {
    // Buscamos los elementos; si no existen (otra página sin cabecera) no hacemos nada.
    const bar = document.querySelector<HTMLElement>('.header__bar');
    const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
    if (!bar || !toggle) return;
    // `set(open)`: único sitio que cambia el estado; mantiene sincronizados el atributo data-open
    // (para el CSS), aria-expanded (para lectores de pantalla) y el texto del botón.
    const set = (open: boolean) => {
      bar.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      const label = toggle.querySelector<HTMLElement>('.header__toggle-text');
      if (label) label.textContent = (open ? label.dataset.open : label.dataset.closed) ?? '';
    };
    // Clic en el botón: alterna entre abierto y cerrado.
    toggle.addEventListener('click', () => set(bar.dataset.open !== 'true'));
    // Tecla Escape con el menú abierto: lo cierra y devuelve el foco al botón (buena práctica de accesibilidad).
    bar.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && bar.dataset.open === 'true') {
        event.stopPropagation();
        set(false);
        toggle.focus();
      }
    });
    // Al pulsar cualquier enlace del menú, se cierra.
    bar.querySelectorAll('.header__nav a').forEach((link) => link.addEventListener('click', () => set(false)));
  };
  // Con ClientRouter la página no se recarga del todo al navegar; el evento `astro:page-load` salta en
  // la primera carga y en cada navegación, así el menú se vuelve a preparar siempre.
  document.addEventListener('astro:page-load', setup);
</script>
