---
/**
 * Reverso de carta estilo Yu-Gi-Oh con motivo de arcano del tarot de P3R (plan §14.5).
 * Un símbolo por proyecto. Los símbolos son SVG originales, no arte del juego.
 */
interface Props {
  numeral: string;
  title: string;
  symbol: 'magician' | 'priestess' | 'empress' | 'emperor' | 'hierophant';
}

const { numeral, title, symbol } = Astro.props;
---

<div class="tarot fx-flip" aria-hidden="true">
  <div class="tarot__face">
    <div class="tarot__swirl fx-swirl"></div>
    <div class="tarot__frame"></div>
    <div class="tarot__numeral">{numeral}</div>
    <div class="tarot__disc">
      <svg
        width="120"
        height="120"
        viewBox="0 0 100 100"
        fill="none"
        stroke="#e8c66a"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        {symbol === 'magician' && (
          <>
            <path d="M20 36 C20 22 44 22 50 36 C56 50 80 50 80 36 C80 22 56 22 50 36 C44 50 20 50 20 36 Z" />
            <path d="M50 56 L50 92 M41 66 L59 66" />
            <circle cx="50" cy="56" r="3" />
          </>
        )}
        {symbol === 'priestess' && (
          <>
            <path d="M60 14 A24 24 0 1 0 60 58 A18 18 0 1 1 60 14 Z" />
            <path d="M18 74 L50 66 L82 74 L82 90 L50 82 L18 90 Z M50 66 L50 82" />
          </>
        )}
        {symbol === 'empress' && (
          <>
            {[0, 60, 120, 180, 240, 300].map((angle) => (
              <ellipse cx="50" cy="28" rx="8" ry="16" transform={`rotate(${angle} 50 50)`} />
            ))}
            <circle cx="50" cy="50" r="6" />
          </>
        )}
        {symbol === 'emperor' && (
          <>
            <path d="M50 16 L80 32 L80 68 L50 84 L20 68 L20 32 Z M20 32 L50 48 L80 32 M50 48 L50 84" />
            <path d="M28 58 L35 65 L44 52" />
          </>
        )}
        {symbol === 'hierophant' && (
          <>
            <circle cx="50" cy="28" r="13" />
            <circle cx="50" cy="28" r="5" />
            <path d="M50 41 L50 88 M50 70 L63 70 M50 80 L60 80" />
          </>
        )}
      </svg>
    </div>
    <div class="tarot__name">{title}</div>
  </div>
</div>

<style>
  .tarot {
    position: absolute;
    inset: 0;
    padding: 10px;
    box-sizing: border-box;
    border-radius: 14px;
    background: var(--color-surface);
    border: 2px solid var(--color-gold);
    animation-delay: 0.08s;
  }
  .tarot__face {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid rgba(232, 198, 106, 0.6);
    background: repeating-radial-gradient(circle at 50% 46%, #0d2b22 0 7px, #133f31 7px 9px);
  }
  .tarot__swirl {
    position: absolute;
    inset: -50%;
    background: conic-gradient(
      from 0deg,
      rgba(232, 198, 106, 0),
      rgba(232, 198, 106, 0.18) 10%,
      rgba(232, 198, 106, 0) 22%,
      rgba(73, 224, 240, 0.16) 45%,
      rgba(232, 198, 106, 0) 58%,
      rgba(57, 255, 136, 0.16) 80%,
      rgba(232, 198, 106, 0)
    );
  }
  .tarot__frame {
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(232, 198, 106, 0.55);
    border-radius: 4px;
  }
  .tarot__numeral {
    position: absolute;
    left: 0;
    right: 0;
    top: 26px;
    text-align: center;
    font-family: Georgia, serif;
    font-size: 34px;
    color: var(--color-gold);
    letter-spacing: 0.1em;
  }
  .tarot__disc {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 170px;
    height: 170px;
    transform: translate(-50%, -54%);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(#04100b 58%, rgba(4, 16, 11, 0) 72%);
  }
  .tarot__name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26px;
    text-align: center;
    font-family: Georgia, serif;
    font-size: 15px;
    letter-spacing: 0.25em;
    color: var(--color-gold);
  }
</style>
