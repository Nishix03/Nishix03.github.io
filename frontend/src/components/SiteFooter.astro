---
/** Pie de Stack y Contact: crédito y contador de orbes. Va en el slot "after" de PageShell. */
import { getContent } from '../content';

const { footer } = getContent();
---

<footer class="footer">
  <span class="footer__credit">{footer.credit}</span>
  <span class="footer__orbs mono">{footer.orbs}</span>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    width: 100%;
    box-sizing: border-box;
    max-width: var(--page-max);
    margin: auto auto 0;
    padding: 20px var(--gutter) 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 14px;
    border-top: 1px solid rgba(168, 240, 200, 0.12);
    font-size: 13px;
    color: var(--color-mint);
  }
  .footer__credit {
    max-width: 640px;
  }
</style>
